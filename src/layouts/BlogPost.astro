---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { columnPath, url } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  column?: CollectionEntry<'columns'>;
}

const { title, description, date, column } = Astro.props;
---

<BaseLayout title={title} description={description} article>
  <article class="blog-post">
    <div class="prose">
      <div class="title">
        <div class="date">
          <FormattedDate date={date} />
          {column && <span> · <a href={columnPath(column)}>{column.data.title}</a></span>}
        </div>
        <h1>{title}</h1>
        <hr />
      </div>
      <slot />
      <p class="article-back"><a href={url('posts/')}>返回文章列表</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  /* Adapted from the MIT-licensed Astro Blog Starter's BlogPost.astro. */
  :global(main.article-page) {
    width: calc(100% - 2em);
    max-width: 100%;
    margin: 0;
  }
  .prose {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: auto;
    padding: 1em;
    color: rgb(var(--gray-dark));
  }
  .title {
    margin-bottom: 1em;
    padding: 1em 0;
    text-align: center;
    line-height: 1;
  }
  .title h1 {
    margin: 0 0 0.5em 0;
    overflow-wrap: anywhere;
  }
  .date {
    margin-bottom: 0.5em;
    color: rgb(var(--gray));
  }
  .article-back {
    margin-top: 2em;
  }
  .prose :global(pre) {
    position: relative;
    overflow-x: auto;
    padding-top: 3em;
  }
  .prose :global(pre > code) {
    display: block;
    width: max-content;
    min-width: 100%;
  }
  .prose :global(.copy-code) {
    position: absolute;
    top: 0.75em;
    right: 1em;
    padding: 0.2em 0.6em;
    border: 1px solid #636a72;
    border-radius: 2px;
    color: #e3e7ec;
    background: #32383f;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .title h1 {
      font-size: 2em;
      line-height: 1.3;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLPreElement>('.blog-post .prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = '复制';
    button.setAttribute('aria-label', '复制这段代码');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
        button.textContent = '已复制';
      } catch {
        button.textContent = '请手动选择复制';
      }
      window.setTimeout(() => { button.textContent = '复制'; }, 2000);
    });
    pre.append(button);
  });
</script>
