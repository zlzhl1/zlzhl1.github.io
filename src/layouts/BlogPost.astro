---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { columnPath, url } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  column?: CollectionEntry<'columns'>;
}

const { title, description, date, column } = Astro.props;
---

<BaseLayout title={title} description={description} article>
  <article class="blog-post">
    <div class="prose">
      <div class="title">
        <div class="date">
          <FormattedDate date={date} />
          {column && <span> · <a href={columnPath(column)}>{column.data.title}</a></span>}
        </div>
        <h1>{title}</h1>
        <hr />
      </div>
      <slot />
      <p class="article-back"><a href={url('posts/')}>返回文章列表</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  /* Reading structure remains based on the MIT-licensed Astro Blog Starter. */
  :global(main.article-page) { width: min(840px, calc(100% - 40px)); margin-inline: auto; padding: 42px 44px 52px; }
  .prose { width: 100%; max-width: 740px; margin-inline: auto; padding: 0; color: #594b32; font-size: 17px; line-height: 1.95; }
  .title { margin-bottom: 36px; padding: 0; text-align: left; }
  .title h1 { margin: 15px 0 27px; overflow-wrap: anywhere; text-wrap: balance; font-size: clamp(29px, 4vw, 41px); line-height: 1.45; letter-spacing: -.035em; color: #493c29; }
  .title hr { margin: 0; border-top: 2px dashed #b9a26b; }
  .date { color: #857047; font-size: 13px; font-family: var(--font-mono); }
  .date a { color: #52783b; text-decoration: none; }
  .prose :global(p) { margin-bottom: 1.45em; }
  .prose :global(h2) { margin: 2em 0 .8em; font-size: 26px; line-height: 1.55; color: #4a6231; }
  .prose :global(h3) { margin: 1.7em 0 .7em; font-size: 21px; line-height: 1.6; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; margin: 0 0 1.5em; }
  .prose :global(li) { margin: .45em 0; }
  .prose :global(li::marker) { color: #6f8c43; }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; overscroll-behavior-x: contain; margin: 25px 0 30px; border: 1px solid #c9b17b; border-radius: 8px; border-collapse: collapse; font-size: 14px; line-height: 1.75; }
  .prose :global(th), .prose :global(td) { min-width: 92px; padding: 10px 13px; border: 1px solid #d9c79e; text-align: left; vertical-align: top; }
  .prose :global(th) { color: #3e572d; background: #e6ebc4; font-weight: 700; }
  .prose :global(tbody tr:nth-child(even)) { background: #f5eacb; }
  .article-back { margin-top: 45px; padding-top: 23px; border-top: 2px dashed #c1aa72; font-size: 14px; }
  .article-back a { display: inline-flex; min-height: 40px; align-items: center; padding: 4px 14px; border: 2px solid #839448; border-radius: 7px; background: #e6ebc4; text-decoration: none; color: #45642e; }
  .prose :global(pre) { position: relative; overflow-x: auto; margin: 28px 0; padding: 52px 20px 20px; font-size: 14px; line-height: 1.75; box-shadow: inset 0 3px #334c36; }
  .prose :global(pre > code) { display: block; width: max-content; min-width: 100%; }
  .prose :global(.copy-code) { position: absolute; top: 10px; right: 12px; padding: 5px 10px; border: 1px solid #b6c387; border-radius: 6px; color: #344e2c; background: #e5ebc2; cursor: pointer; font-size: 12px; }
  .prose :global(.copy-code:hover) { border-color: #dce7ab; color: #223f22; background: #f0f3d9; }
  @media (max-width: 720px) {
    :global(main.article-page) { width: calc(100% - 24px); padding: 28px 18px 35px; }
    .prose { font-size: 16px; }
    .title { margin-bottom: 30px; }
    .title h1 { font-size: 29px; line-height: 1.5; margin-block: 13px 21px; }
    .prose :global(h2) { font-size: 23px; }
    .prose :global(h3) { font-size: 20px; }
    .prose :global(pre) { padding-inline: 14px; font-size: 13px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLPreElement>('.blog-post .prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = '复制';
    button.setAttribute('aria-label', '复制这段代码');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
        button.textContent = '已复制';
      } catch {
        button.textContent = '请手动选择复制';
      }
      window.setTimeout(() => { button.textContent = '复制'; }, 2000);
    });
    pre.append(button);
  });
</script>
