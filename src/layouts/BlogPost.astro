---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { columnPath, url } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  column?: CollectionEntry<'columns'>;
}

const { title, description, date, column } = Astro.props;
---

<BaseLayout title={title} description={description} article>
  <article class="blog-post">
    <div class="prose">
      <div class="title">
        <div class="date">
          <FormattedDate date={date} />
          {column && <span> · <a href={columnPath(column)}>{column.data.title}</a></span>}
        </div>
        <h1>{title}</h1>
        <hr />
      </div>
      <slot />
      <p class="article-back"><a href={url('posts/')}>返回文章列表</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  /* Reading structure remains based on the MIT-licensed Astro Blog Starter. */
  :global(main.article-page) {
    width: min(780px, calc(100% - 64px));
    margin-inline: auto;
    padding-top: 56px;
  }
  .prose {
    width: 100%;
    max-width: 740px;
    margin-inline: auto;
    padding: 0;
    color: #cbd5df;
    font-size: 17px;
    line-height: 1.95;
  }
  .title {
    margin-bottom: 42px;
    padding: 0;
    text-align: left;
  }
  .title h1 {
    margin: 15px 0 28px;
    overflow-wrap: anywhere;
    text-wrap: balance;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.45;
    letter-spacing: -.035em;
  }
  .title hr { margin: 0; }
  .date {
    color: var(--muted);
    font-size: 13px;
    font-family: var(--font-mono);
  }
  .date a { color: var(--accent); text-decoration: none; }
  .prose :global(p) { margin-bottom: 1.45em; }
  .prose :global(h2) { margin: 2em 0 .8em; font-size: 26px; line-height: 1.55; }
  .prose :global(h3) { margin: 1.7em 0 .7em; font-size: 21px; line-height: 1.6; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; margin: 0 0 1.5em; }
  .prose :global(li) { margin: .45em 0; }
  .article-back {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .article-back a { text-decoration: none; }
  .prose :global(pre) {
    position: relative;
    overflow-x: auto;
    margin: 28px 0;
    padding: 52px 20px 20px;
    font-size: 14px;
    line-height: 1.75;
  }
  .prose :global(pre > code) {
    display: block;
    width: max-content;
    min-width: 100%;
  }
  .prose :global(.copy-code) {
    position: absolute;
    top: 10px;
    right: 12px;
    padding: 5px 10px;
    border: 1px solid rgba(218, 235, 248, .16);
    border-radius: 6px;
    color: #cbd5df;
    background: #1a2631;
    cursor: pointer;
    font-size: 12px;
  }
  .prose :global(.copy-code:hover) { border-color: rgba(156, 229, 197, .35); color: var(--accent); }
  @media (max-width: 720px) {
    :global(main.article-page) { width: calc(100% - 40px); padding-top: 36px; }
    .prose { font-size: 16px; }
    .title { margin-bottom: 32px; }
    .title h1 { font-size: 30px; line-height: 1.5; margin-block: 14px 22px; }
    .prose :global(h2) { font-size: 23px; }
    .prose :global(h3) { font-size: 20px; }
    .prose :global(pre) { padding-inline: 14px; font-size: 13px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLPreElement>('.blog-post .prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = '复制';
    button.setAttribute('aria-label', '复制这段代码');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
        button.textContent = '已复制';
      } catch {
        button.textContent = '请手动选择复制';
      }
      window.setTimeout(() => { button.textContent = '复制'; }, 2000);
    });
    pre.append(button);
  });
</script>
