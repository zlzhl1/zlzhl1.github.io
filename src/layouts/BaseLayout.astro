---
import { SITE, CATEGORIES } from '../config';
import { url } from '../lib/posts';
import AIBackdrop from '../components/AIBackdrop.astro';
import '../styles/global.css';
import '../styles/themes.css';

interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = SITE.description, article = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, SITE.siteUrl).href;
const navigation = [
  { name: '首页', href: url() },
  ...CATEGORIES.map((category) => ({ name: category.name, href: url(`columns/${category.id}/`) })),
  { name: '全部文章', href: url('posts/') },
  { name: '归档', href: url('archives/') },
  { name: '关于', href: url('about/') },
];
const backgroundThemes = [
  { id: 'model', name: '大模型' },
  { id: 'training', name: '训练' },
  { id: 'workflow', name: '工作流' },
  { id: 'agent', name: 'Agent' },
];
---
<!doctype html>
<html lang="zh-CN" data-ai-theme="model">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f6ff" />
    <script is:inline>
      (() => {
        let theme = 'model';
        try {
          const saved = localStorage.getItem('chaohui-ai-theme');
          if (['model', 'training', 'workflow', 'agent'].includes(saved)) theme = saved;
        } catch {}
        document.documentElement.dataset.aiTheme = theme;
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={url('rss.xml')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="site-header">
      <AIBackdrop />
      <div class="container">
        <div class="header-masthead">
          <a class="site-title" href={url()}>{SITE.title}</a>
          <div class="theme-switcher" role="group" aria-label="背景主题">
            {backgroundThemes.map((theme) => <button class="theme-choice" type="button" data-theme-choice={theme.id} aria-label={`切换到${theme.name}主题`} aria-pressed={theme.id === 'model'} disabled><span class={`theme-dot theme-dot-${theme.id}`} aria-hidden="true"></span>{theme.name}</button>)}
          </div>
        </div>
        <nav class="main-nav" aria-label="主导航">
          {navigation.map((item) => {
            const active = item.href === url() ? pathname === item.href : pathname.startsWith(item.href);
            return <a href={item.href} class:list={{ active }} aria-current={active ? 'page' : undefined}>{item.name}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container">© {new Date().getFullYear()} {SITE.author}</div></footer>
  </body>
</html>

<script>
  const themeNames = ['model', 'training', 'workflow', 'agent'];
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const root = document.documentElement;
  const applyTheme = (value: string) => {
    const theme = themeNames.includes(value) ? value : 'model';
    root.dataset.aiTheme = theme;
    themeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme)));
    try { localStorage.setItem('chaohui-ai-theme', theme); } catch {}
  };
  themeButtons.forEach((button) => {
    button.disabled = false;
    button.addEventListener('click', () => applyTheme(button.dataset.themeChoice || 'model'));
  });
  applyTheme(root.dataset.aiTheme || 'model');
  root.dataset.themesReady = 'true';
</script>
