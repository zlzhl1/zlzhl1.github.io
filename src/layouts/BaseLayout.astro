---
import { SITE, CATEGORIES } from '../config';
import { url } from '../lib/posts';
import AIBackdrop from '../components/AIBackdrop.astro';
import '../styles/global.css';
import '../styles/themes.css';

interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = SITE.description, article = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, SITE.siteUrl).href;
const navigation = [
  { name: '首页', href: url() },
  ...CATEGORIES.map((category) => ({ name: category.name, href: url(`columns/${category.id}/`) })),
  { name: '全部文章', href: url('posts/') },
  { name: '归档', href: url('archives/') },
  { name: '关于', href: url('about/') },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f7fb" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={url('rss.xml')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <AIBackdrop />
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="site-header">
      <div class="container">
        <div class="header-masthead">
          <a class="site-title" href={url()}>{SITE.title}</a>
          <a class="github-link" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub：zlzhl1（新窗口打开）" title="GitHub · zlzhl1">
            <svg width="24" height="24" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        </div>
        <nav class="main-nav" aria-label="主导航">
          {navigation.map((item) => {
            const active = item.href === url() ? pathname === item.href : pathname.startsWith(item.href);
            return <a href={item.href} class:list={{ active }} aria-current={active ? 'page' : undefined}>{item.name}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container">© {new Date().getFullYear()} {SITE.author}</div></footer>
  </body>
</html>
