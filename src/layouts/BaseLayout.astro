---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props { title?: string; description?: string; article?: boolean; }
const { title, description, article = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head><BaseHead title={title} description={description} article={article} /></head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <Header />
    <main id="main" class:list={{ 'article-page': article }}><slot /></main>
    <Footer />
  </body>
</html>
