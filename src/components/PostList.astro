---
import type { CollectionEntry } from 'astro:content';
import PostRow from './PostRow.astro';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => <li data-article data-column={post.data.column?.id || ''} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLocaleLowerCase()}><PostRow post={post} /></li>)}
</ul>
<style>
  /* List layout from withastro/astro/examples/blog/src/pages/blog/index.astro. */
  ul { display: flex; flex-wrap: wrap; gap: 2rem; list-style-type: none; margin: 0; padding: 0; }
  li { width: calc(50% - 1rem); }
  li:first-child { width: 100%; margin-bottom: 1rem; text-align: center; }
  li:first-child :global(.title) { font-size: 2.369rem; }
  @media (max-width: 720px) {
    ul { gap: 1.5em; }
    li { width: 100%; text-align: center; }
    li:first-child { margin-bottom: 0; }
    li:first-child :global(.title) { font-size: 1.563em; }
  }
</style>
