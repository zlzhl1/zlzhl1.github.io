---
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---
<figure class="architecture" data-project-architecture aria-label={`${project.shortTitle}的系统架构示意`}>
  <ol class="architecture-flow">
    {project.architecture.map((node, index) => <li class:list={{ collaborator: node.collaborator }}>
      <span class="node-step">0{index + 1}</span>
      <strong>{node.title}</strong>
      <span class="node-detail">{node.detail}</span>
      {node.collaborator && <span class="node-owner">协作方主责</span>}
    </li>)}
  </ol>
  <figcaption>{project.architectureNote}</figcaption>
</figure>
<style>
  .architecture { margin: 0; }
  .architecture-flow { display: flex; padding: 0; margin: 0; list-style: none; gap: 22px; }
  li { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; padding: 17px 13px 18px; border: 2px solid #8f9f58; border-radius: 10px; background: #e9edcc; }
  li:not(:last-child)::after { content: '→'; position: absolute; right: -21px; top: 50%; transform: translateY(-50%); color: #8b915a; font-size: 19px; }
  .node-step { color: #8a9b5b; font: 700 12px var(--font-mono); }
  strong { color: #4c6334; font-size: 15px; line-height: 1.6; }
  .node-detail { color: #7c7d53; font-size: 12px; line-height: 1.8; }
  .collaborator { background: #f3e8c8; border-color: #bea16c; border-style: dashed; }
  .node-owner { align-self: flex-start; color: #957540; font-size: 10px; padding: 1px 5px; border: 1px solid #c6b17a; border-radius: 3px; }
  figcaption { margin-top: 15px; color: #8a7a55; font-size: 12px; line-height: 1.9; }
  @media (max-width: 780px) { .architecture-flow { flex-direction: column; gap: 19px; } li { display: grid; grid-template-columns: 25px 1fr; gap: 2px 9px; padding: 13px 15px; } .node-step { grid-row: span 2; padding-top: 4px; } .node-detail { grid-column: 2; } .node-owner { grid-column: 2; justify-self: start; } li:not(:last-child)::after { content: '↓'; right: 50%; top: auto; bottom: -23px; transform: translateX(50%); font-size: 17px; } }
</style>
