---
import { SITE } from '../config';
import { url } from '../lib/posts';
import HeaderLink from './HeaderLink.astro';
---
<header class="site-header">
  <nav aria-label="主导航">
    <a class="brand" href={url()}>
      <span class="brand-mark" aria-hidden="true">D<span></span></span>
      <span class="brand-title">{SITE.title}</span>
    </a>
    <div class="internal-links">
      <HeaderLink href={url()}>首页</HeaderLink>
      <HeaderLink href={url('posts/')}>文章</HeaderLink>
      <HeaderLink href={url('columns/')}>栏目</HeaderLink>
      <HeaderLink href={url('archives/')}>归档</HeaderLink>
      <HeaderLink href={url('about/')}>关于</HeaderLink>
    </div>
    <a class="github-link" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="戴夫（Dave）的 GitHub（新窗口打开）" title="戴夫（Dave） · GitHub">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
    </a>
  </nav>
</header>
<style>
  .site-header { position: sticky; top: 12px; z-index: 30; width: min(1120px, calc(100% - 24px)); margin: 14px auto 0; border: 3px solid #544029; border-radius: 15px 12px 17px 13px; background: repeating-linear-gradient(176deg, transparent 0 15px, #976b3b33 16px 17px, transparent 18px 29px), linear-gradient(#d5af71, #c08c4d 65%, #af7b40); box-shadow: inset 0 2px 0 #f6d99b, inset 0 -3px 0 #8d622f, 0 5px 0 #4b573445, 0 8px 18px #2d512e20; }
  nav { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 8px 13px 9px 15px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; min-width: 0; color: #483822; text-decoration: none; }
  .brand-mark { position: relative; display: grid; place-items: center; width: 37px; height: 37px; flex: 0 0 37px; border: 2px solid #4c542c; border-radius: 12px 10px 12px 8px; background: linear-gradient(#b9cc6b, #769448); color: #fff8d6; font-size: 25px; font-weight: 700; line-height: 1; text-shadow: 1px 2px #4c542c; box-shadow: inset 0 2px #dce8a0, 0 2px #806039; transform: rotate(-4deg); }
  .brand-mark span { position: absolute; width: 9px; height: 5px; right: -5px; top: -3px; border: 1px solid #4c542c; border-radius: 9px 1px 9px 1px; background: #b5cb66; transform: rotate(-25deg); }
  .brand-title { font-size: 17px; font-weight: 700; letter-spacing: -.025em; white-space: nowrap; text-shadow: 0 1px #f3d69a; }
  .internal-links { display: flex; align-items: center; gap: 5px; }
  .github-link { display: grid; place-items: center; flex: 0 0 43px; width: 43px; height: 43px; border: 2px solid #66502c; border-radius: 11px; color: #4a4a2c; background: #eed49a; box-shadow: inset 0 2px #fff1c5, 0 3px #805d31; transition: transform .2s ease, background .2s ease; }
  .github-link:hover { color: #325725; background: #f5e4b5; transform: translateY(-2px) rotate(3deg); }
  @media (max-width: 840px) {
    .site-header { top: 8px; margin-top: 10px; }
    nav { flex-wrap: wrap; gap: 5px 10px; padding: 8px 10px 9px; }
    .brand { order: 1; flex: 1; }
    .brand-title { font-size: 15px; }
    .brand-mark { width: 31px; height: 31px; flex-basis: 31px; font-size: 21px; }
    .github-link { order: 2; width: 39px; height: 39px; flex-basis: 39px; }
    .internal-links { order: 3; width: 100%; justify-content: center; padding-top: 5px; border-top: 1px solid #8d693a66; }
  }
  @media (max-width: 420px) {
    nav { gap: 4px 7px; padding-inline: 9px; }
    .brand { gap: 7px; }
    .brand-title { font-size: 14px; }
    .brand-mark { width: 28px; height: 29px; flex-basis: 28px; font-size: 20px; }
    .github-link { width: 36px; height: 36px; flex-basis: 36px; }
  }
  @media (max-width: 350px) { .brand-title { font-size: 13px; } .brand-mark { width: 25px; flex-basis: 25px; } }
  @media (prefers-reduced-motion: reduce) { .github-link:hover { transform: none; } }
</style>
