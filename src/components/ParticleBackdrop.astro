<div class="particle-backdrop" data-particle-backdrop data-paused="false" aria-hidden="true">
  <canvas class="particle-canvas"></canvas>
</div>

<style>
  .particle-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
    background:
      radial-gradient(ellipse at 100% 22%, #70bfc80a, transparent 47%),
      radial-gradient(ellipse at 0% 82%, #9ce5c507, transparent 38%);
  }
  .particle-canvas { display: block; width: 100%; height: 100%; }
  @media print { .particle-backdrop { display: none; } }
</style>

<script>
  type Point = { x: number; y: number; alpha: number; radius: number };
  const cleanups = new Set<() => void>();

  function initializeBackdrops() {
    document.querySelectorAll<HTMLElement>('[data-particle-backdrop]').forEach((backdrop) => {
      if (backdrop.dataset.ready === 'true') return;
      const canvas = backdrop.querySelector<HTMLCanvasElement>('.particle-canvas');
      const context = canvas?.getContext('2d');
      if (!canvas || !context) return;
      backdrop.dataset.ready = 'true';

      const toggle = document.querySelector<HTMLButtonElement>('[data-particle-toggle]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
      let paused = false;
      try { paused = localStorage.getItem('dave-particles-paused') === 'true'; } catch { /* Storage may be unavailable. */ }
      let width = 0;
      let height = 0;
      let frame = 0;
      let elapsed = 0;
      let previous = 0;
      let lastDraw = 0;
      let pointerX = 0;
      let pointerY = 0;
      let targetX = 0;
      let targetY = 0;

      // Each row follows the same folded surface. Connections stay local;
      // there is no random star field or quadratic neighbour search.
      function pointAt(u: number, v: number, band: number, time: number): Point {
        const mobile = width < 700;
        const phase = time * .000055;
        const bend = u * Math.PI * 2 - .8 + phase;
        const twist = u * Math.PI * 2.6 + phase * .65 + band * 1.3;
        const right = band === 0;
        const centerX = right
          ? width * (.91 + .115 * Math.sin(bend))
          : width * (.045 + .12 * Math.sin(bend + 1.4));
        const centerY = height * (-.2 + 1.43 * u + band * .13);
        const spread = width * (mobile ? .24 : .16);
        const x = centerX + v * spread * Math.cos(twist) + pointerX * (right ? 11 : -7);
        const y = centerY + v * height * .12 * Math.sin(twist) + Math.sin(bend * 1.7) * height * .035 + pointerY * 8;
        const edgeDistance = Math.abs(x / width - .5) * 2;
        const centerFade = .11 + .89 * Math.pow(Math.min(1, edgeDistance), 2.3);
        const ends = Math.sin(Math.PI * u) ** .5;
        const depth = .68 + .32 * Math.cos(twist + v * .5);
        const pulse = .85 + .15 * Math.sin(u * 13 + v * 2 - phase * 3);
        const alpha = centerFade * ends * depth * pulse * (right ? .64 : .37);
        return { x, y, alpha, radius: (.72 + depth * .5) * (mobile ? .9 : 1) };
      }

      function draw(time: number) {
        if (!width || !height) return;
        context!.clearRect(0, 0, width, height);
        const mobile = width < 700;
        const columns = mobile ? 26 : 43;
        const rows = mobile ? 6 : 8;
        backdrop.dataset.particles = String(columns * rows * 2);

        for (let band = 0; band < 2; band++) {
          const color = band === 0 ? '144, 209, 218' : '156, 229, 197';
          const points: Point[][] = [];
          for (let row = 0; row < rows; row++) {
            const v = (row / (rows - 1) - .5) * 2;
            const line: Point[] = [];
            for (let col = 0; col < columns; col++) {
              line.push(pointAt(col / (columns - 1), v, band, time));
            }
            points.push(line);
          }

          context!.lineWidth = .65;
          for (let row = 0; row < rows; row++) {
            for (let col = 0; col < columns; col++) {
              const point = points[row][col];
              const previousPoint = col > 0 ? points[row][col - 1] : null;
              if (previousPoint) {
                context!.beginPath();
                context!.moveTo(previousPoint.x, previousPoint.y);
                context!.lineTo(point.x, point.y);
                context!.strokeStyle = `rgba(${color},${Math.min(point.alpha, previousPoint.alpha) * .26})`;
                context!.stroke();
              }
              // Sparse cross-lines reveal a mesh without turning the background into a grid.
              if (row > 0 && col % 3 === 0) {
                const across = points[row - 1][col];
                context!.beginPath();
                context!.moveTo(across.x, across.y);
                context!.lineTo(point.x, point.y);
                context!.strokeStyle = `rgba(${color},${Math.min(point.alpha, across.alpha) * .14})`;
                context!.stroke();
              }
              context!.beginPath();
              context!.arc(point.x, point.y, point.radius, 0, Math.PI * 2);
              context!.fillStyle = `rgba(${color},${point.alpha})`;
              context!.fill();
            }
          }
        }
      }

      function shouldAnimate() { return !paused && !reduced.matches && !document.hidden; }
      function tick(now: number) {
        frame = 0;
        if (!shouldAnimate()) return;
        if (previous) elapsed += Math.min(now - previous, 80);
        previous = now;
        if (now - lastDraw >= 1000 / 24) {
          pointerX += (targetX - pointerX) * .08;
          pointerY += (targetY - pointerY) * .08;
          draw(elapsed);
          lastDraw = now;
        }
        frame = requestAnimationFrame(tick);
      }
      function updateMotion() {
        backdrop.dataset.paused = String(paused);
        backdrop.dataset.running = String(shouldAnimate());
        if (toggle) {
          toggle.hidden = reduced.matches;
          toggle.setAttribute('aria-pressed', String(paused));
          const label = paused ? '开启背景动效' : '暂停背景动效';
          toggle.setAttribute('aria-label', label);
          toggle.title = label;
        }
        if (shouldAnimate()) {
          if (!frame) frame = requestAnimationFrame(tick);
        } else {
          if (frame) cancelAnimationFrame(frame);
          frame = 0;
          previous = 0;
          lastDraw = 0;
        }
      }
      function setPaused(value: boolean) {
        paused = value;
        try { localStorage.setItem('dave-particles-paused', String(paused)); } catch { /* Optional preference. */ }
        updateMotion();
      }
      function onToggle() { setPaused(!paused); }
      function onExternalMotion(event: Event) {
        const detail = (event as CustomEvent<{ paused?: unknown }>).detail;
        if (typeof detail?.paused === 'boolean') setPaused(detail.paused);
      }
      function onPointerMove(event: PointerEvent) {
        if (!shouldAnimate() || !finePointer.matches) return;
        targetX = event.clientX / width - .5;
        targetY = event.clientY / height - .5;
      }
      function onPointerLeave() { targetX = 0; targetY = 0; }
      function resize() {
        width = backdrop.clientWidth;
        height = backdrop.clientHeight;
        const dpr = Math.min(devicePixelRatio || 1, width < 700 ? 1.5 : 2);
        canvas!.width = Math.round(width * dpr);
        canvas!.height = Math.round(height * dpr);
        context!.setTransform(dpr, 0, 0, dpr, 0, 0);
        draw(elapsed);
      }

      const observer = new ResizeObserver(resize);
      observer.observe(backdrop);
      toggle?.addEventListener('click', onToggle);
      document.addEventListener('particle-motion-change', onExternalMotion);
      document.addEventListener('visibilitychange', updateMotion);
      reduced.addEventListener('change', updateMotion);
      window.addEventListener('pointermove', onPointerMove, { passive: true });
      document.documentElement.addEventListener('pointerleave', onPointerLeave);
      resize();
      updateMotion();

      const cleanup = () => {
        if (frame) cancelAnimationFrame(frame);
        observer.disconnect();
        toggle?.removeEventListener('click', onToggle);
        document.removeEventListener('particle-motion-change', onExternalMotion);
        document.removeEventListener('visibilitychange', updateMotion);
        reduced.removeEventListener('change', updateMotion);
        window.removeEventListener('pointermove', onPointerMove);
        document.documentElement.removeEventListener('pointerleave', onPointerLeave);
        delete backdrop.dataset.ready;
        cleanups.delete(cleanup);
      };
      cleanups.add(cleanup);
    });
  }

  function cleanupBackdrops() { for (const cleanup of cleanups) cleanup(); }
  initializeBackdrops();
  document.addEventListener('astro:page-load', initializeBackdrops);
  document.addEventListener('astro:before-swap', cleanupBackdrops);
  window.addEventListener('pagehide', cleanupBackdrops);
  window.addEventListener('pageshow', initializeBackdrops);
</script>
