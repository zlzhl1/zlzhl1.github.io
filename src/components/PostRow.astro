---
import type { CollectionEntry } from 'astro:content';
import { categoryFor, formatDate, postPath, url } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; number?: string; }
const { post, number } = Astro.props;
const category = categoryFor(post.data.category);
---

<article class="post-row">
  {number && <span class="post-number" aria-hidden="true">{number}</span>}
  <div class="post-row-content">
    <div class="post-meta"><a class={`category-label category-${post.data.category}`} href={url(`columns/${post.data.category}/`)}>{category.name}</a><span aria-hidden="true">/</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div>
    <h3><a href={postPath(post)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    {post.data.tags.length > 0 && <div class="post-tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div>}
  </div>
  <a class="post-arrow" href={postPath(post)} aria-label={`阅读：${post.data.title}`}><span aria-hidden="true">↗</span></a>
</article>
