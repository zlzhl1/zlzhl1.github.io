---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getPostColumn, columnPath, postPath } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; number?: string; variant?: 'card' | 'journal'; }
const { post, number, variant = 'card' } = Astro.props;
const column = await getPostColumn(post);
---
<article class:list={['post-row', { 'journal-row': variant === 'journal' }]}>
  {variant === 'journal' ? <>
    <time class="journal-date" datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10).replaceAll('-', '.')}</time>
    <div class="journal-main">
      <h2 class="title"><a href={postPath(post)}>{post.data.title}</a></h2>
      <p class="description">{post.data.description}</p>
      <div class="entry-tags">{column ? <a href={columnPath(column)}>{column.data.title}</a> : post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}</div>
    </div>
    <span class="entry-arrow" aria-hidden="true">↗</span>
  </> : <>
  <div class="entry-top"><span class="entry-number">{number || '—'}</span><FormattedDate date={post.data.date} /></div>
  <h2 class="title"><a href={postPath(post)}>{post.data.title}</a></h2>
  <p class="description">{post.data.description}</p>
  <div class="entry-bottom"><div class="entry-tags">{column ? <a href={columnPath(column)}>{column.data.title}</a> : post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}</div><span class="entry-arrow" aria-hidden="true">↗</span></div>
  </>}
</article>
<style>
  .post-row { position: relative; display: flex; flex-direction: column; height: 100%; padding: 23px 24px 22px; border: 2px solid #9a8250; border-radius: 12px 9px 13px 10px; background: linear-gradient(115deg, #fff9df, #f7e8b9); box-shadow: inset 0 0 0 4px #fff4cf, 0 5px 0 #cfb575; transition: box-shadow .2s ease, transform .2s ease; }
  .post-row:hover { transform: translateY(-4px) rotate(-.35deg); box-shadow: inset 0 0 0 4px #fff8df, 0 9px 0 #c4aa6f, 0 13px 20px #715b2820; }
  .entry-top { display: flex; align-items: center; justify-content: space-between; color: #897149; font: 11px/1.5 var(--font-mono); margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px dashed #c4ae73; gap: 15px; }
  .entry-number { display: inline-flex; align-items: center; gap: 8px; color: #557139; font-weight: 700; }
  .entry-number::before { content: ''; width: 18px; height: 10px; border: 1.5px solid #597337; border-radius: 14px 2px 14px 2px; background: linear-gradient(145deg, #d3de86, #7fa24b); transform: rotate(-28deg); }
  .title { margin: 0 0 12px; font-size: 21px; line-height: 1.6; letter-spacing: -.02em; font-weight: 700; }
  .title a { display: block; color: #493c29; text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: 12px; }
  .title a:hover { color: #52783b; }
  .title a:focus-visible { outline: none; }
  .post-row:focus-within { outline: 3px solid #52783b; outline-offset: 4px; }
  .description { color: #786743; font-size: 14px; line-height: 1.85; margin: 0 0 23px; }
  .entry-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: auto; gap: 12px; }
  .entry-tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .entry-tags span, .entry-tags a { position: relative; z-index: 1; font-size: 11px; color: #63783b; background: #e8edc7; border: 1px solid #bbc48a; border-radius: 5px 7px 5px 6px; padding: 2px 8px; line-height: 1.7; text-decoration: none; }
  .entry-tags a:hover { color: #385c26; border-color: #638744; background: #e0e8b6; }
  .entry-tags span { pointer-events: none; }
  .entry-arrow { display: grid; place-items: center; flex: 0 0 32px; width: 32px; height: 32px; color: #fff7d7; border: 1px solid #42652e; border-radius: 50%; background: #688a44; box-shadow: inset 0 2px #a7bd6e, 0 2px #43632c; font-size: 20px; line-height: 1; transition: transform .2s ease, background .2s ease; }
  .post-row:hover .entry-arrow { transform: rotate(9deg); background: #7d9d4f; }
  .journal-row { display: grid; grid-template-columns: 100px minmax(0, 1fr) 32px; align-items: start; gap: 20px; padding: 24px; background: #fff4d2; }
  .journal-row:hover { transform: translateY(-2px); }
  .journal-date { padding-top: 8px; font: 11px/1.6 var(--font-mono); color: #897149; white-space: nowrap; }
  .journal-main { min-width: 0; }
  .journal-row .title { font-size: 21px; margin-bottom: 7px; }
  .journal-row .description { margin-bottom: 12px; font-size: 13px; }
  .journal-row > .entry-arrow { margin-top: 5px; }
  @media (max-width: 720px) {
    .post-row { padding: 21px; }
    .title { font-size: 20px; }
    .journal-row { grid-template-columns: minmax(0, 1fr) 32px; gap: 7px 12px; }
    .journal-date { grid-column: 1 / -1; padding: 0; }
    .journal-main { grid-row: 2; grid-column: 1; }
    .journal-row .title { font-size: 18px; line-height: 1.65; }
    .journal-row .description { font-size: 13.5px; margin-bottom: 10px; }
    .journal-row > .entry-arrow { grid-row: 2; grid-column: 2; margin-top: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .post-row, .entry-arrow { transition: none; } .post-row:hover, .post-row:hover .entry-arrow { transform: none; } }
</style>
