---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getPostColumn, columnPath, postPath } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const column = await getPostColumn(post);
---
<article class="post-row">
  <h2 class="title"><a href={postPath(post)}>{post.data.title}</a></h2>
  <p class="date"><FormattedDate date={post.data.date} />{column && <> · <a href={columnPath(column)}>{column.data.title}</a></>}</p>
</article>
<style>
  .title { margin: 0; font-size: 1.563em; line-height: 1.2; }
  .title a { display: block; color: rgb(var(--black)); text-decoration: none; }
  .date { margin: .5em 0 0; color: rgb(var(--gray)); }
  .date a { color: inherit; }
  .title a:hover, .date a:hover { color: var(--accent); }
</style>
