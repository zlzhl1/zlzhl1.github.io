  @media (prefers-reduced-motion:reduce) { .open-hatch,.shelf-slot { animation:none; }.car-key { animation-duration:18s; }.seed-packet,.read-arrow,.all-notes span,.license-plate { transition:none; }.seed-packet:hover,.seed-packet:focus-within { transform:rotate(var(--packet-tilt)); } }
</style>

<script>
  const trunkCleanups = new Set<() => void>();
  function initializeTrunks() {
    document.querySelectorAll<HTMLElement>('[data-dave-trunk]').forEach((trunk) => {
      if (trunk.dataset.ready === 'true') return;
      const button = trunk.querySelector<HTMLButtonElement>('[data-trunk-knock]');
      const status = trunk.querySelector<HTMLElement>('[data-knock-status]');
      if (!button) return;
      trunk.dataset.ready = 'true';
      let timer = 0;
      let frame = 0;
      let knocks = 0;
      const onKnock = () => {
        window.clearTimeout(timer);
        if (frame) cancelAnimationFrame(frame);
        trunk.classList.remove('is-rattling');
        frame = requestAnimationFrame(() => { trunk.classList.add('is-rattling'); frame = 0; });
        trunk.dataset.knocks = String(++knocks);
        if (status) status.textContent = knocks % 2 ? '咚咚，后备箱里都是新鲜笔记！' : '咚咚，戴夫的后备箱装得稳稳的。';
        timer = window.setTimeout(() => { trunk.classList.remove('is-rattling'); }, 650);
      };
      button.addEventListener('click', onKnock);
      const cleanup = () => {
        window.clearTimeout(timer); if (frame) cancelAnimationFrame(frame);
        button.removeEventListener('click', onKnock); trunk.classList.remove('is-rattling');
        delete trunk.dataset.ready; trunkCleanups.delete(cleanup);
      };
      trunkCleanups.add(cleanup);
    });
  }
  function cleanupTrunks() { for (const cleanup of trunkCleanups) cleanup(); }
  initializeTrunks();
  document.addEventListener('astro:page-load', initializeTrunks);
  document.addEventListener('astro:before-swap', cleanupTrunks);
  window.addEventListener('pagehide', cleanupTrunks);
  window.addEventListener('pageshow', initializeTrunks);
</script>
