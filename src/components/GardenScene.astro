---
import { url } from '../lib/posts';
---
<div class="garden-scene" data-garden-scene aria-hidden="true">
  <div class="garden-painting" style={`background-image: url("${url('garden/garden-backdrop.webp')}")`}></div>
  <svg class="cloud cloud-one" viewBox="0 0 220 90"><path d="M25 73C-2 72 0 37 29 35C24 5 72-3 87 24C105 2 144 14 145 38C181 17 209 38 202 56C233 63 221 83 196 81Z" fill="#fffbe9" /></svg>
  <svg class="cloud cloud-two" viewBox="0 0 220 90"><path d="M25 73C-2 72 0 37 29 35C24 5 72-3 87 24C105 2 144 14 145 38C181 17 209 38 202 56C233 63 221 83 196 81Z" fill="#fffbe9" /></svg>
  <div class="garden-vignette"></div>
</div>
<style>
  .garden-scene { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; background: #c5e3d6; }
  .garden-painting { position: absolute; inset: 0; background-size: cover; background-position: center bottom; }
  .garden-vignette { position: absolute; inset: 0; background: linear-gradient(#e9f7da10, transparent 48%, #416a261a); }
  .cloud { position: absolute; width: 200px; opacity: .68; filter: drop-shadow(0 4px 0 #71a8a31a); animation: cloud-drift 64s ease-in-out infinite alternate; }
  .cloud-one { top: 8%; left: 8%; }
  .cloud-two { width: 140px; top: 17%; right: 6%; animation-duration: 89s; animation-delay: -22s; opacity: .45; }
  :global(.garden-resting) .cloud { animation-play-state: paused; }
  @keyframes cloud-drift { from { transform: translateX(-22px); } to { transform: translateX(92px); } }
  @media (max-width: 600px) { .garden-painting { background-position: 56% bottom; } .cloud { width: 130px; } }
  @media (prefers-reduced-motion: reduce) { .cloud { animation-duration: 150s; } }
</style>
<script>
  let disposeGarden = () => {};
  function initializeGarden() {
    disposeGarden();
    if (!document.querySelector('[data-garden-scene]')) return;
    const rest = () => document.body.classList.toggle('garden-resting', document.hidden);
    document.addEventListener('visibilitychange', rest); rest();
    disposeGarden = () => document.removeEventListener('visibilitychange', rest);
  }
  initializeGarden();
  document.addEventListener('astro:page-load', initializeGarden);
  document.addEventListener('astro:before-swap', () => disposeGarden());
  window.addEventListener('pagehide', () => disposeGarden());
  window.addEventListener('pageshow', initializeGarden);
</script>
