---
import type { HTMLAttributes } from 'astro/types';
import { url } from '../lib/posts';
type Props = HTMLAttributes<'a'> & { activePaths?: string[] };
const { href, class: className, activePaths = [], ...props } = Astro.props;
const pathname = Astro.url.pathname;
const target = typeof href === 'string' ? href : '';
const isActive = (target === url() ? pathname === target : target !== '' && (pathname === target || pathname.startsWith(target.endsWith('/') ? target : `${target}/`))) || activePaths.some((path) => pathname === path || pathname.startsWith(path.endsWith('/') ? path : `${path}/`));
---
<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}><slot /></a>
<style>
  a { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 7px 14px; border: 2px solid transparent; border-radius: 9px 11px 8px 10px; color: #4e3b22; font-size: 14px; font-weight: 700; line-height: 1.4; white-space: nowrap; text-decoration: none; transition: color .18s ease, background .18s ease, transform .18s ease; }
  a:hover { color: #3b5928; background: #efd59b; transform: translateY(-1px); }
  a.active { color: #fff9dc; background: linear-gradient(#7a9a4a, #577e37); border-color: #405c29; box-shadow: inset 0 2px #aec46d, 0 3px #5a552c; text-shadow: 0 1px #3a582a; }
  @media (max-width: 840px) { a { flex: 1; padding-inline: 10px; } }
  @media (max-width: 420px) { a { padding-inline: 6px; font-size: 13px; min-height: 40px; } }
  @media (prefers-reduced-motion: reduce) { a:hover { transform: none; } }
</style>
