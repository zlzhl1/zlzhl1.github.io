---
import type { HTMLAttributes } from 'astro/types';
import { url } from '../lib/posts';
type Props = HTMLAttributes<'a'>;
const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname;
const target = typeof href === 'string' ? href : '';
const isActive = target === url() ? pathname === target : target !== '' && (pathname === target || pathname.startsWith(target.endsWith('/') ? target : `${target}/`));
---
<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}><slot /></a>
<style>
  a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 8px 14px; border: 1px solid transparent; border-radius: 10px; color: #a9b5c1; font-size: 14px; line-height: 1.4; white-space: nowrap; text-decoration: none; transition: color .25s ease, background .25s ease, border-color .25s ease; }
  a:hover { color: var(--ink); background: rgba(218, 235, 248, .04); }
  a.active { color: #c6f3df; background: rgba(156, 229, 197, .065); border-color: rgba(156, 229, 197, .1); }
  @media (max-width: 840px) { a { flex: 1; padding-inline: 10px; } }
  @media (max-width: 420px) { a { padding-inline: 8px; font-size: 13px; } }
</style>
