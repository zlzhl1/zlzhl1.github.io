---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects';
import { url } from '../lib/posts';
---

<BaseLayout title="项目全景" description="了解戴夫的四个AI项目：业务目标、系统架构、个人贡献、关键工程取舍，以及实际结果与证据范围。">
  <header class="portfolio-intro">
    <p class="eyebrow">从具体问题，到完整项目</p>
    <div class="page-heading"><h1>项目全景</h1><span class="page-count">{PROJECTS.length} 个项目</span></div>
    <p class="intro-text">系统怎样工作，我负责了什么，哪些选择值得复盘。每个项目都从一个真实问题开始，沿着架构、贡献和结果展开。</p>
    <div class="intro-guide"><span>业务目标</span><i aria-hidden="true">→</i><span>系统架构</span><i aria-hidden="true">→</i><span>个人贡献</span><i aria-hidden="true">→</i><span>结果与判断</span></div>
  </header>

  <div class="project-grid" data-project-overview>
    {PROJECTS.map((project) => <article class="project-card" data-project-card={project.id}>
      <div class="card-top"><span class="project-number">{project.number}</span><span class="project-category">{project.category}</span></div>
      <h2><a href={url(`projects/${project.id}/`)}>{project.shortTitle}</a></h2>
      <p class="project-summary">{project.summary}</p>
      <div class="role-block"><span>我的角色</span><p>{project.role}</p></div>
      <div class="result-block"><div><strong>{project.preview.value}</strong><span>{project.preview.label}</span></div><small>{project.preview.basis}</small></div>
      <div class="stack-list" aria-label="项目技术栈">{project.stack.slice(0, 5).map((tech) => <span>{tech}</span>)}</div>
      <a class="project-open" href={url(`projects/${project.id}/`)}>查看项目全貌<span aria-hidden="true"> ↗</span></a>
    </article>)}
  </div>

  <aside class="portfolio-note"><strong>结果有各自的口径</strong><p>个人职责采用最新确认，业务规模、人工评审与历史实验分别标明依据。团队整体结果不自动归因于某一个人的单项修改。</p></aside>
  <section class="reading-links" aria-label="继续阅读"><div><h2>想继续看具体做法？</h2><p>项目里保留整体脉络，技术文章展开参数、实验与工程细节。</p></div><a href={url('posts/')}>阅读技术文章 <span aria-hidden="true">→</span></a><a href={url('columns/')}>按栏目浏览 <span aria-hidden="true">→</span></a></section>
</BaseLayout>

<style>
  .portfolio-intro { margin-bottom: 32px; }
  .eyebrow { margin: 0 0 9px; color: #6b7a43; font-size: 13px; font-weight: 700; letter-spacing: .09em; }
  .page-heading { margin-bottom: 18px; }
  .intro-text { max-width: 730px; color: #776542; font-size: 17px; line-height: 1.95; margin-bottom: 22px; }
  .intro-guide { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; color: #6a7947; font-size: 12px; }
  .intro-guide span { padding: 4px 10px; border: 1px solid #bcc28b; border-radius: 5px; background: #eaf0d0; }
  .intro-guide i { color: #a9aa77; font-style: normal; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .project-card { display: flex; flex-direction: column; padding: 25px 27px 24px; border: 2px solid #a9a06d; border-radius: 13px 18px 12px 16px; background: #fff9e6; box-shadow: 0 6px #d8c68e; min-width: 0; }
  .card-top { display: flex; align-items: center; gap: 13px; margin-bottom: 17px; }
  .project-number { color: #93a065; font: 700 27px/1 var(--font-mono); }
  .project-category { color: #95835b; font-size: 11px; }
  .project-card h2 { margin-bottom: 13px; font-size: 25px; line-height: 1.6; }
  .project-card h2 a { color: #496237; text-decoration: none; }
  .project-card h2 a:hover { color: #799343; }
  .project-summary { margin-bottom: 20px; color: #83734f; font-size: 14px; line-height: 1.95; }
  .role-block { padding: 12px 14px; border-left: 3px solid #a6b576; border-radius: 0 5px 5px 0; background: #edf0d6; }
  .role-block > span { color: #899167; font-size: 10px; }
  .role-block p { margin: 4px 0 0; color: #5d6e3e; font-size: 13px; font-weight: 700; line-height: 1.8; }
  .result-block { margin: 21px 0 17px; padding-bottom: 17px; border-bottom: 1px dashed #d4c398; }
  .result-block > div { display: flex; align-items: baseline; flex-wrap: wrap; gap: 11px; }
  .result-block strong { color: #927044; font-size: 29px; line-height: 1.5; }
  .result-block span { color: #87734f; font-size: 12px; }
  .result-block small { display: block; margin-top: 4px; color: #9b8b64; font-size: 10px; line-height: 1.8; }
  .stack-list { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 22px; }
  .stack-list span { color: #8a815d; font: 10px/1.7 var(--font-mono); border: 1px solid #d1c8a3; border-radius: 4px; padding: 2px 6px; }
  .project-open { display: flex; justify-content: space-between; margin-top: auto; padding: 10px 13px; border: 2px solid #8fa15e; border-radius: 7px; background: #e4ebc2; color: #536d36; font-size: 13px; font-weight: 700; text-decoration: none; transition: background .18s; }
  .project-open:hover { background: #d7e3ad; }
  .portfolio-note { margin-top: 29px; padding: 18px 21px; border: 1px dashed #bea977; border-radius: 10px; background: #f4ebce; }
  .portfolio-note strong { color: #7a6a45; font-size: 12px; }
  .portfolio-note p { color: #97845c; font-size: 12px; line-height: 1.9; margin: 5px 0 0; }
  .reading-links { display: flex; flex-wrap: wrap; align-items: center; gap: 13px; margin-top: 29px; padding-top: 23px; border-top: 2px dashed #cbb583; }
  .reading-links > div { flex: 1 1 320px; }
  .reading-links h2 { font-size: 18px; margin-bottom: 6px; }
  .reading-links p { color: #94805a; font-size: 12px; margin: 0; }
  .reading-links > a { flex-shrink: 0; color: #5d713e; font-size: 13px; }
  @media (max-width: 700px) { .project-grid { grid-template-columns: minmax(0, 1fr); gap: 21px; } .project-card { padding: 21px; } .project-card h2 { font-size: 23px; } .intro-text { font-size: 15px; } .intro-guide { gap: 5px; font-size: 10px; } .intro-guide span { padding: 3px 6px; } }
</style>
