---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postPath } from '../lib/posts';

const posts = await getPosts();
const byId = new Map(posts.map((post) => [post.id, post]));
const stages = [
  {
    id: 'data', title: '资料治理', label: '先把输入弄可靠',
    question: '资料齐了，为什么还不能直接拿去训练？',
    summary: '从文档解析到候选分流，保留来源、条件和失败记录。',
    takeaway: '格式正确、内容保真、业务确认，需要分别检查。',
    articles: [
      { id: 'document-conversion-recovery', note: '表格、公式、图片与断点恢复，怎样逐个处理。' },
      { id: 'data-juicer-dataflow-practice', note: '复用算子，给出引文，让无法确认的资料进入复核。' },
    ],
  },
  {
    id: 'knowledge', title: '知识检索', label: '让回答有据可查',
    question: '建成知识图谱之后，歧义和误合并怎么办？',
    summary: '看实体、关系、原文证据怎样衔接，也看不确定时如何保留。',
    takeaway: '两个名字很像，还不足以证明它们是同一个对象。',
    articles: [
      { id: 'lightrag-entity-resolution', note: '同类型召回、候选分差、关系改写与提示词版本管理。' },
    ],
  },
  {
    id: 'training', title: '训练实验', label: '讲清参数与结果',
    question: '训练做了什么，参数为什么这样设，结果说明了什么？',
    summary: '从路线选择进入真实实验，再检查性能、选模、监督分母和恢复成本。',
    takeaway: '同一条曲线的趋势、不同实验的比较，要用不同的证据回答。',
    articles: [
      { id: 'llamafactory-training-stack', note: '先分清训练阶段、更新范围和分布式策略。' },
      { id: 'cpt-sft-experiment-review', note: '沿9B实际父权重，解释长度、学习率和选模。' },
      { id: 'microbatch-speed-probe', note: '18步探针里的中位数、均值与长尾，怎样影响判断。' },
      { id: 'validation-best-and-early-stop', note: 'best、last、早停和业务退化，分别需要什么依据。' },
      { id: 'loss-denominator-and-tokenizer', note: '追到有效监督token，理解loss究竟除以了什么。' },
      { id: 'training-run-identity-and-resume', note: '同名目录、回退重算与恢复状态，怎样留清楚记录。' },
    ],
  },
  {
    id: 'delivery', title: '应用交付', label: '让能力稳定可用',
    question: '从能调用模型，到用户能用、结果能验收，还差什么？',
    summary: '串起客户端适配、交互可靠性和评测口径，回到真实使用问题。',
    takeaway: '调用成功、队列可靠、分数变好，都需要讲清各自的边界。',
    articles: [
      { id: 'openclaw-enterprise-client', note: '开源基座之外，我补上的身份、模型接入和客户端能力。' },
      { id: 'agent-scheduling-and-outbox', note: '后台任务让路、会话投影与持久化补偿，怎样协同。' },
      { id: 'evalscope-comparable-evaluation', note: '核对模型、预测和评分身份，再解释116题的结果。' },
    ],
  },
].map((stage) => ({
  ...stage,
  articles: stage.articles.flatMap((entry) => {
    const post = byId.get(entry.id);
    return post ? [{ post, note: entry.note }] : [];
  }),
})).filter((stage) => stage.articles.length > 0);
const includedIds = new Set(stages.flatMap((stage) => stage.articles.map(({ post }) => post.id)));
const more = posts.filter((post) => post.id !== 'getting-started' && !includedIds.has(post.id));
const opening = byId.get('getting-started');
---

<BaseLayout title="实践地图" description="按问题探索戴夫的AI实践：资料治理、知识检索、训练实验与应用交付，查看具体做法、实验依据和个人总结。">
  <section class="map-intro">
    <p class="map-kicker">从一个具体问题出发</p>
    <div class="page-heading"><h1>实践地图</h1><span class="page-count">{includedIds.size + more.length} 篇实践</span></div>
    <p class="map-lead">我做过什么，为什么这样选，又发现了什么。沿着下面四条主线，找到你正在关心的问题。</p>
    <nav class="map-stops" aria-label="选择实践主题">
      {stages.map((stage, index) => <a href={`#${stage.id}`}><span class="stop-number">0{index + 1}</span><span><strong>{stage.title}</strong><small>{stage.label}</small></span><span class="stop-arrow" aria-hidden="true">↓</span></a>)}
    </nav>
  </section>

  <div class="map-stages">
    {stages.map((stage, index) => <section class="map-stage" id={stage.id} aria-labelledby={`${stage.id}-title`}>
      <header class="stage-heading">
        <span class="stage-number" aria-hidden="true">0{index + 1}</span>
        <h2 id={`${stage.id}-title`}>{stage.title}</h2>
        <p>{stage.summary}</p>
        <span class="stage-count">{stage.articles.length} 篇 · 按问题阅读</span>
      </header>
      <div class="stage-content">
        <h3 class="stage-question">{stage.question}</h3>
        <ul class="map-articles">
          {stage.articles.map(({ post, note }) => <li><a href={postPath(post)}>{post.data.title}<span aria-hidden="true"> ↗</span></a><p>{note}</p></li>)}
        </ul>
        <p class="stage-takeaway"><span>我的体会</span>{stage.takeaway}</p>
      </div>
    </section>)}
  </div>

  {more.length > 0 && <section class="more-practice"><h2>继续探索</h2><ul>{more.map((post) => <li><a href={postPath(post)}>{post.data.title}</a></li>)}</ul></section>}
  {opening && <aside class="map-welcome"><div><strong>第一次来到这里？</strong><p>先认识这个后备箱，以及我希望怎样记录实践。</p></div><a href={postPath(opening)}>从这里开始 <span aria-hidden="true">→</span></a></aside>}
</BaseLayout>

<style>
  .map-intro { margin-bottom: 34px; }
  .map-kicker { margin: 0 0 9px; color: #6a7b3e; font-size: 13px; font-weight: 700; letter-spacing: .1em; }
  .page-heading { margin-bottom: 18px; }
  .map-lead { max-width: 740px; margin-bottom: 26px; color: #74623f; font-size: 17px; line-height: 1.9; }
  .map-stops { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .map-stops a { display: flex; align-items: center; gap: 10px; padding: 16px 12px; color: #493c29; border: 2px solid #a5aa67; border-radius: 10px 13px 10px 12px; background: #e8edcb; text-decoration: none; box-shadow: 0 4px #c5c68e; transition: transform .18s, background .18s; }
  .map-stops a:hover { transform: translateY(-3px); background: #dfe8b6; }
  .stop-number { color: #7a8d4c; font: 700 16px var(--font-mono); }
  .map-stops strong { display: block; font-size: 16px; }
  .map-stops small { display: block; margin-top: 3px; font-size: 11px; color: #758055; }
  .stop-arrow { margin-left: auto; color: #758055; }
  .map-stages { display: grid; gap: 25px; }
  .map-stage { display: grid; grid-template-columns: 180px minmax(0, 1fr); overflow: hidden; border: 2px solid #b6a36c; border-radius: 12px 16px 12px 14px; background: #fff9e5; box-shadow: 0 5px #ddc893; scroll-margin-top: 150px; }
  .stage-heading { padding: 23px 20px; background: #e9e9c8; border-right: 1px dashed #b6b277; }
  .stage-number { display: block; margin-bottom: 9px; color: #94a56d; font: 700 30px/1 var(--font-mono); }
  .stage-heading h2 { font-size: 23px; margin-bottom: 11px; color: #4e6d36; }
  .stage-heading p { margin-bottom: 18px; color: #78805b; font-size: 13px; line-height: 1.85; }
  .stage-count { font-size: 11px; color: #7d815b; }
  .stage-content { padding: 24px 25px 20px; min-width: 0; }
  .stage-question { margin: 0 0 17px; font-size: 17px; line-height: 1.7; }
  .map-articles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 23px; padding: 0; margin: 0; list-style: none; }
  .map-articles li { padding: 15px 0 14px; border-top: 1px dashed #d7c697; min-width: 0; }
  .map-articles a { display: block; color: #4d6035; font-size: 15px; font-weight: 700; line-height: 1.8; text-decoration: none; }
  .map-articles a:hover { color: #799039; text-decoration: underline; }
  .map-articles a span { color: #93a164; white-space: nowrap; }
  .map-articles p { margin: 7px 0 0; color: #8a7954; font-size: 12px; line-height: 1.8; }
  .stage-takeaway { margin: 8px 0 0; padding: 11px 13px; border-radius: 6px; color: #827043; background: #f4edcd; font-size: 12px; line-height: 1.9; }
  .stage-takeaway span { display: inline-block; margin-right: 9px; color: #5c713c; font-weight: 700; }
  .map-welcome { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 32px; padding: 22px 24px; border: 2px dashed #bea976; border-radius: 12px; background: #f5eaca; }
  .map-welcome strong { color: #665032; font-size: 16px; }
  .map-welcome p { margin: 5px 0 0; color: #8b7954; font-size: 13px; }
  .map-welcome a { flex-shrink: 0; padding: 8px 13px; border: 2px solid #718347; border-radius: 7px; background: #e2e9be; text-decoration: none; font-size: 14px; font-weight: 700; }
  .more-practice { margin-top: 30px; }
  .more-practice h2 { font-size: 23px; }
  @media (max-width: 900px) { .map-stops { grid-template-columns: repeat(2, minmax(0, 1fr)); } .map-stage { grid-template-columns: 155px minmax(0, 1fr); } .map-articles { grid-template-columns: minmax(0, 1fr); } .stage-content { padding-inline: 20px; } }
  @media (max-width: 620px) { .map-lead { font-size: 15px; } .map-stops { gap: 10px; } .map-stops a { padding: 13px 10px; gap: 8px; } .map-stops strong { font-size: 15px; } .map-stops small { font-size: 10px; } .stop-number { font-size: 14px; } .map-stage { grid-template-columns: minmax(0, 1fr); } .stage-heading { padding: 17px 19px; border-right: 0; border-bottom: 1px dashed #b6b277; } .stage-number { display: inline-block; margin: 0 10px 0 0; font-size: 22px; vertical-align: baseline; } .stage-heading h2 { display: inline; font-size: 21px; } .stage-heading p { margin: 9px 0 4px; } .stage-content { padding: 19px; } .stage-question { font-size: 16px; } .map-welcome { flex-direction: column; align-items: flex-start; padding: 19px; gap: 14px; } }
  @media (max-width: 380px) { .map-stops .stop-number, .map-stops .stop-arrow { display: none; } .map-stops strong { white-space: nowrap; } }
  @media (prefers-reduced-motion: reduce) { .map-stops a { transition: none; } .map-stops a:hover { transform: none; } }
</style>
