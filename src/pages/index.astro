---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrunkScene from '../components/TrunkScene.astro';
import PostList from '../components/PostList.astro';
import { getPosts, url } from '../lib/posts';
const posts = await getPosts();
---
<BaseLayout home>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span aria-hidden="true"></span>DAVE / PERSONAL SPACE</p>
      <h1 class="hero-title" id="hero-title">把探索，<br />装进<span>后备箱。</span></h1>
      <p class="hero-description">关于 AI、代码，<br class="mobile-break" />和那些值得留下的想法。</p>
      <div class="hero-actions">
        <a class="button-primary" href="#latest">翻翻后备箱 <span aria-hidden="true">↘</span></a>
        <a class="button-secondary" href={url('about/')}>认识戴夫 <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <TrunkScene posts={posts.slice(0, 3)} />
  </section>
  <section class="home-section" id="latest" aria-labelledby="latest-title">
    <div class="section-heading">
      <div><p class="section-label">RECENT ENTRIES</p><h2 id="latest-title">最近放进来的</h2></div>
      <a class="section-link" href={url('posts/')}>全部文章 <span aria-hidden="true">↗</span></a>
    </div>
    {posts.length > 0 ? <PostList posts={posts.slice(0, 3)} layout="grid" /> : <p class="empty-message">暂时还空着，想法正在路上。</p>}
  </section>
</BaseLayout>
<style>
  .home-hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; min-height: 480px; gap: 24px; padding: 12px 0 40px; }
  .hero-copy { position: relative; z-index: 1; padding: 28px 0; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: var(--muted); font: 11px/1.5 var(--font-mono); letter-spacing: .15em; margin: 0 0 26px; }
  .eyebrow span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 14px #9ce5c550; }
  .hero-title { font-size: clamp(43px, 4.9vw, 64px); line-height: 1.25; letter-spacing: -.055em; font-weight: 600; margin: 0; color: var(--ink); }
  .hero-title span { color: var(--accent); }
  .hero-description { color: var(--muted); font-size: 17px; line-height: 1.8; margin: 25px 0 30px; letter-spacing: .015em; }
  .mobile-break { display: none; }
  .hero-actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .button-primary, .button-secondary { display: inline-flex; align-items: center; gap: 18px; font-size: 14px; text-decoration: none; min-height: 46px; }
  .button-primary { color: #0b1512; background: var(--accent); padding: 0 20px; border: 1px solid #b6f1d9; border-radius: 9px; box-shadow: 0 3px 16px #9ce5c510; transition: background .2s ease, transform .2s ease, box-shadow .2s ease; }
  .button-primary:hover { color: #0b1512; background: #b8f2d8; transform: translateY(-2px); box-shadow: 0 5px 24px #9ce5c520; }
  .button-secondary { color: var(--ink); transition: color .2s ease; }
  .button-secondary:hover { color: var(--accent); }
  .home-section { margin: 22px 0 48px; scroll-margin-top: 120px; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 25px; }
  .section-label { font: 10px/1.5 var(--font-mono); letter-spacing: .16em; color: var(--muted); margin: 0 0 9px; }
  .section-heading h2 { font-size: 24px; line-height: 1.4; letter-spacing: -.035em; margin: 0; font-weight: 550; }
  .section-link { display: inline-flex; gap: 14px; align-items: center; min-height: 44px; color: var(--muted); font-size: 13px; text-decoration: none; white-space: nowrap; }
  .section-link:hover { color: var(--accent); }
  @media (max-width: 800px) {
    :global(main.home-page) { padding-top: 10px; }
    .home-hero { gap: 0; grid-template-columns: 1fr; min-height: 0; padding: 0 0 25px; }
    .hero-copy { padding: 25px 0 0; }
    .hero-title { font-size: clamp(40px, 8vw, 58px); }
    .hero-description { margin-block: 20px 25px; font-size: 16px; }
    .home-section { margin-top: 6px; }
  }
  @media (max-width: 420px) {
    .hero-title { font-size: 40px; }
    .eyebrow { margin-bottom: 20px; font-size: 10px; }
    .hero-actions { gap: 18px; }
    .button-primary { padding-inline: 16px; }
    .section-heading h2 { font-size: 21px; }
  }
  @media (prefers-reduced-motion: reduce) { .button-primary, .button-secondary { transition: none; } .button-primary:hover { transform: none; } }
</style>
