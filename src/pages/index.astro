---
import BaseLayout from '../layouts/BaseLayout.astro';
import DaveTrunk from '../components/DaveTrunk.astro';
import { getPosts } from '../lib/posts';
const posts = await getPosts();
---
<BaseLayout home>
  <DaveTrunk posts={posts.slice(0, 6)} total={posts.length} />
</BaseLayout>
<style>
  :global(main.home-page) { width: min(1080px, calc(100% - 40px)); margin-top: 16px; margin-bottom: 0; padding-top: 16px; padding-bottom: 18px; }
  @media (min-width: 1320px) { :global(main.home-page) { transform: translateX(45px); } }
  @media (max-width: 720px) {
    :global(main.home-page) { width: calc(100% - 20px); padding-top: 16px; padding-bottom: 30px; }
  }
</style>
