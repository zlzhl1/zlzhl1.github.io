---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArchitecture from '../../components/ProjectArchitecture.astro';
import { PROJECTS, type Project } from '../../data/projects';
import { getPosts, postPath, url } from '../../lib/posts';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({ params: { project: project.id }, props: { project } }));
}
interface Props { project: Project; }
const { project } = Astro.props;
const posts = await getPosts();
const related = project.articles.flatMap((entry) => {
  const post = posts.find((post) => post.id === entry.id);
  return post ? [{ post, note: entry.note }] : [];
});
---

<BaseLayout title={`${project.shortTitle} · 项目全景`} description={project.summary}>
  <article class="project-detail" data-project-id={project.id}>
    <a class="back-projects" href={url('practice/')}>← 所有项目</a>
    <header class="project-hero">
      <p class="project-eyebrow">项目 {project.number} <span>· {project.category}</span></p>
      <h1>{project.title}</h1>
      <p class="project-lead">{project.summary}</p>
      <div class="project-role"><span>我的角色</span><strong>{project.role}</strong><p>{project.scope}</p></div>
      <ul class="tech-tags" aria-label="项目技术栈">{project.stack.map((tech) => <li>{tech}</li>)}</ul>
    </header>

    <nav class="detail-nav" aria-label="项目内容"><a href="#architecture">系统架构</a><a href="#contributions">我的贡献</a><a href="#decisions">关键取舍</a><a href="#outcomes">结果与依据</a></nav>

    <section class="detail-section project-goal"><h2><span>01</span>要解决什么问题</h2><p>{project.goal}</p></section>
    <section class="detail-section" id="architecture"><h2><span>02</span>系统怎样工作</h2><ProjectArchitecture project={project} /></section>
    <section class="detail-section" id="contributions" data-project-contributions><h2><span>03</span>我做了什么</h2><ol class="contribution-list">{project.contributions.map((entry) => <li><h3>{entry.title}</h3><p>{entry.detail}</p></li>)}</ol></section>
    <section class="detail-section" id="decisions" data-project-decisions><h2><span>04</span>关键工程取舍</h2><div class="decision-grid">{project.decisions.map((entry) => <article class="decision"><h3>{entry.title}</h3><dl><dt>遇到的问题</dt><dd>{entry.problem}</dd><dt>采用的做法</dt><dd>{entry.choice}</dd><dt>选择的理由</dt><dd>{entry.reason}</dd></dl></article>)}</div></section>
    <section class="detail-section" id="outcomes" data-project-outcomes><h2><span>05</span>结果与验证范围</h2><div class="outcome-grid">{project.outcomes.map((entry) => <div class="outcome"><strong>{entry.value}</strong><h3>{entry.label}</h3><span class="evidence-label">{entry.basis}</span><p>{entry.detail}</p></div>)}</div></section>
    <section class="reflection detail-section"><h2><span>06</span>我的复盘</h2><p class="reflection-main">{project.reflection}</p><h3>下一步怎样验证</h3><p>{project.next}</p></section>

    {related.length > 0 && <section class="detail-section related-articles"><h2><span>07</span>继续看技术细节</h2><ul>{related.map(({ post, note }) => <li><a href={postPath(post)}>{post.data.title}<span aria-hidden="true"> ↗</span></a><p>{note}</p></li>)}</ul></section>}
    <footer class="project-source"><p>资料依据：2026年11月4日最新本人确认稿，以及各自标注时点的源码、提交和实验记录。项目状态和指标沿用其证据范围。</p><a href={url('practice/')}>返回项目全景 →</a></footer>
  </article>
</BaseLayout>

<style>
  .back-projects { color: #8b7b52; font-size: 12px; text-decoration: none; }
  .back-projects:hover { color: #4d7138; }
  .project-hero { margin-top: 25px; }
  .project-eyebrow { margin: 0 0 11px; color: #78924d; font: 700 12px var(--font-mono); }
  .project-eyebrow span { margin-left: 8px; color: #9a875c; font-size: 11px; font-weight: 400; }
  .project-hero h1 { max-width: 860px; font-size: clamp(29px, 3.7vw, 39px); line-height: 1.6; }
  .project-lead { max-width: 800px; margin: 17px 0 23px; color: #84734d; font-size: 16px; line-height: 1.95; }
  .project-role { padding: 16px 19px; border-left: 4px solid #9caf69; border-radius: 0 8px 8px 0; background: #edf0d5; }
  .project-role > span { display: block; color: #91976a; font-size: 11px; margin-bottom: 5px; }
  .project-role strong { color: #58723c; font-size: 15px; }
  .project-role p { color: #828463; font-size: 13px; line-height: 1.95; margin: 8px 0 0; }
  .tech-tags { display: flex; flex-wrap: wrap; gap: 7px; padding: 0; list-style: none; margin: 18px 0 25px; }
  .tech-tags li { padding: 3px 8px; border: 1px solid #c9bd91; border-radius: 4px; color: #8b7e57; font: 11px/1.8 var(--font-mono); }
  .detail-nav { display: flex; flex-wrap: wrap; gap: 8px; padding: 15px 0; margin: 0 0 9px; border-block: 1px dashed #cbb987; }
  .detail-nav a { padding: 5px 11px; border-radius: 5px; background: #f0e6c1; color: #7e704c; font-size: 12px; text-decoration: none; }
  .detail-nav a:hover { background: #e4eac3; color: #597139; }
  .detail-section { margin-top: 34px; scroll-margin-top: 150px; }
  .detail-section > h2 { display: flex; align-items: baseline; gap: 12px; margin-bottom: 20px; color: #4f6a38; font-size: 24px; line-height: 1.6; }
  .detail-section > h2 span { font: 700 14px var(--font-mono); color: #a3ac7b; }
  .project-goal > p { margin: 0; color: #776747; font-size: 16px; line-height: 2; }
  .contribution-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px 27px; margin: 0; padding: 0; list-style: none; counter-reset: contributions; }
  .contribution-list li { position: relative; padding: 15px 0 10px 28px; border-top: 1px dashed #d1c39b; counter-increment: contributions; }
  .contribution-list li::before { content: counter(contributions, decimal-leading-zero); position: absolute; left: 0; top: 20px; color: #adb383; font: 10px var(--font-mono); }
  .contribution-list h3 { color: #637346; font-size: 16px; line-height: 1.8; }
  .contribution-list p { color: #897952; font-size: 13px; line-height: 2; margin: 7px 0 0; }
  .decision-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 19px; }
  .decision { padding: 20px; border: 1px solid #c8b586; border-radius: 9px; background: #fbf1d2; }
  .decision h3 { font-size: 18px; color: #7e6b3f; line-height: 1.8; }
  .decision dl { margin: 15px 0 0; }
  .decision dt { font-size: 10px; color: #a79562; font-weight: 700; margin-top: 13px; }
  .decision dd { margin: 4px 0 0; color: #83734f; font-size: 13px; line-height: 1.95; }
  .outcome-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 17px; }
  .outcome { padding: 19px; border: 2px solid #a9b47a; border-radius: 10px; background: #f0f0d7; min-width: 0; }
  .outcome > strong { display: block; color: #657a43; font-size: clamp(23px, 2.6vw, 31px); line-height: 1.6; overflow-wrap: anywhere; }
  .outcome h3 { margin: 7px 0 9px; color: #6f7951; font-size: 14px; }
  .evidence-label { display: inline-block; color: #9a8a5f; font-size: 10px; }
  .outcome p { margin: 12px 0 0; padding-top: 12px; border-top: 1px dashed #c9c798; color: #8b835b; font-size: 12px; line-height: 1.95; }
  .reflection { padding: 23px; border-radius: 10px; border: 1px dashed #b7a371; background: #f4e8c8; }
  .reflection > h2 { margin-bottom: 14px; }
  .reflection-main { color: #77623f; font-size: 16px; line-height: 2; }
  .reflection h3 { font-size: 12px; color: #928051; }
  .reflection p:last-child { font-size: 13px; color: #97845b; line-height: 1.95; margin-bottom: 0; }
  .related-articles ul { padding: 0; margin: 0; list-style: none; }
  .related-articles li { padding: 13px 0; border-top: 1px dashed #d6c69a; }
  .related-articles a { color: #59713c; font-size: 14px; font-weight: 700; text-decoration: none; line-height: 1.8; }
  .related-articles a:hover { text-decoration: underline; }
  .related-articles p { margin: 5px 0 0; color: #a28e61; font-size: 11px; }
  .project-source { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 30px; padding-top: 20px; border-top: 2px dashed #cbb786; }
  .project-source p { flex: 1 1 400px; color: #aa9670; font-size: 10px; line-height: 1.9; margin: 0; }
  .project-source a { color: #6b7d45; font-size: 12px; flex-shrink: 0; }
  @media (max-width: 680px) { .project-hero { margin-top: 20px; } .project-hero h1 { font-size: 28px; } .project-lead { font-size: 14px; } .contribution-list, .decision-grid { grid-template-columns: minmax(0, 1fr); } .detail-section > h2 { font-size: 22px; } .decision, .reflection { padding: 18px; } .detail-nav { gap: 6px; } .detail-nav a { padding-inline: 9px; font-size: 11px; } }
</style>
