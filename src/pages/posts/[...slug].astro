---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { getPosts, categoryFor, formatDate, url, postPath } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = categoryFor(post.data.category);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const otherPosts = (await getPosts()).filter((item) => item.id !== post.id).slice(0, 2);
---

<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class="container article-shell">
    <header class="article-header"><a class="back-link" href={url('posts/')}>← 所有文章</a><div class="post-meta"><a class={`category-label category-${post.data.category}`} href={url(`columns/${post.data.category}/`)}>{category.name}</a><span aria-hidden="true">/</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="article-author"><span class="author-avatar" aria-hidden="true">辉</span><span>{SITE.author}<small>记录实践，也记录判断。</small></span></div></header>
    <div class="article-layout"><div class="article-main"><div class="prose"><Content /></div><div class="article-end"><span aria-hidden="true">✳</span><p>感谢读到这里。<br />如果你也在尝试类似的事，欢迎带着具体问题交流。</p><a class="text-link" href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">在 GitHub 找到我 ↗</a></div><div class="article-tags">{post.data.tags.map((tag) => <span>#{tag}</span>)}</div></div>{toc.length > 0 && <aside class="article-toc" aria-label="文章目录"><span class="eyebrow muted">ON THIS PAGE</span><nav>{toc.map((heading) => <a class:list={{ 'toc-sub': heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}</nav><a class="toc-top" href="#main">↑ 回到顶部</a></aside>}</div>
  </article>
  {otherPosts.length > 0 && <section class="container related-section"><div class="section-heading"><div><span class="eyebrow muted">KEEP READING</span><h2>接着读一篇</h2></div></div><div class="related-grid">{otherPosts.map((item) => <a href={postPath(item)}><span class="category-label">{categoryFor(item.data.category).name}</span><h3>{item.data.title}</h3><span class="text-link">阅读手记 ↗</span></a>)}</div></section>}
</BaseLayout>

<script>
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = '复制';
    button.setAttribute('aria-label', '复制这段代码');
    button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || ''); button.textContent = '已复制'; }
      catch { button.textContent = '请手动选择复制'; }
      window.setTimeout(() => { button.textContent = '复制'; }, 2000);
    });
    pre.append(button);
  });
</script>
