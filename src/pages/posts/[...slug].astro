---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, getPostColumn } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
const column = await getPostColumn(post);
---

<BlogPost title={post.data.title} description={post.data.description} date={post.data.date} column={column}>
  <Content />
</BlogPost>
