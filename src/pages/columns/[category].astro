---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORIES } from '../../config';
import { getPosts, url } from '../../lib/posts';
export function getStaticPaths() { return CATEGORIES.map((category) => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.category === category.id);
---

<BaseLayout title={category.name} description={category.description}>
  <div class="container blog-layout">
    <section class="main-column column-posts">
      <header class="page-heading"><h1>{category.name}</h1><span>{posts.length} 篇</span></header>
      {posts.length ? <div class="post-list">{posts.map((post) => <PostRow post={post} />)}</div> : <div class="empty-state"><p>暂无文章。</p><a href={url('posts/')}>查看所有文章</a></div>}
    </section>
    <Sidebar />
  </div>
</BaseLayout>
