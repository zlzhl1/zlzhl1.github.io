---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { CATEGORIES } from '../../config';
import { getPosts, url } from '../../lib/posts';
export function getStaticPaths() { return CATEGORIES.map((category) => ({ params: { category: category.id }, props: { category } })); }
const { category } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.category === category.id);
const index = CATEGORIES.findIndex((item) => item.id === category.id);
---

<BaseLayout title={category.name} description={category.description}>
  <section class={`container page-intro column-page-intro column-${category.id}`}><a class="back-link" href={url('')}>← 回到首页</a><span class="eyebrow muted">COLUMN 0{index + 1}</span><h1>{category.name}<span class="title-dot">.</span></h1><p>{category.description}</p><span class="intro-count">{posts.length} 篇手记 · 持续积累中</span></section>
  <section class="container column-posts"><div class="column-tabs" aria-label="切换栏目">{CATEGORIES.map((item) => <a class:list={{ active: item.id === category.id }} href={url(`columns/${item.id}/`)} aria-current={item.id === category.id ? 'page' : undefined}>{item.name}</a>)}</div>{posts.length ? <div class="post-list narrow-post-list">{posts.map((post) => <PostRow post={post} />)}</div> : <div class="empty-state"><span aria-hidden="true">↳</span><h2>这个栏目，正在积累第一篇。</h2><p>先把问题想清楚，再把过程写下来。</p><a class="text-link" href={url('posts/')}>先读读其他手记 →</a></div>}</section>
</BaseLayout>
